(include "dump_types.lisp")

(defun native_ir_dump_byte (dump byte)
  (declare (type (ptr native_ir_dump) dump) (type u8 byte) (returns c-int))
  (let ((cursor (deref (field-pointer dump 'cursor))))
    (if (= cursor (wrap- (wrap-cast usize 0) 1))
        (progn (store (field-pointer dump 'error) 3) 0)
        (progn
          (if (= (deref (field-pointer dump 'writing)) 1)
              (store (pointer+ (deref (field-pointer (deref (field-pointer dump 'output)) 'data))
                              (wrap-cast isize cursor)) byte) (wrap-cast u8 0))
          (store (field-pointer dump 'cursor) (wrap+ cursor 1)) 1))))

(defun native_ir_dump_text (dump text)
  (declare (type (ptr native_ir_dump) dump) (type (ptr u8) text) (returns c-int))
  (if (= (deref text) 0) 1
      (progn (native_ir_dump_byte dump (deref text))
             (native_ir_dump_text dump (pointer+ text 1)))))

(defun native_ir_dump_span (dump text length)
  (declare (type (ptr native_ir_dump) dump) (type (ptr u8) text)
           (type usize length) (returns c-int))
  (if (= length 0) 1
      (progn (native_ir_dump_byte dump (deref text))
             (native_ir_dump_span dump (pointer+ text 1) (wrap- length 1)))))

(defun native_ir_dump_place (place)
  (declare (type u64 place) (returns u64))
  (cond
    ((= place 10000000000000000000) 1000000000000000000)
    ((= place 1000000000000000000) 100000000000000000)
    ((= place 100000000000000000) 10000000000000000)
    ((= place 10000000000000000) 1000000000000000)
    ((= place 1000000000000000) 100000000000000)
    ((= place 100000000000000) 10000000000000)
    ((= place 10000000000000) 1000000000000)
    ((= place 1000000000000) 100000000000)
    ((= place 100000000000) 10000000000)
    ((= place 10000000000) 1000000000)
    ((= place 1000000000) 100000000)
    ((= place 100000000) 10000000)
    ((= place 10000000) 1000000)
    ((= place 1000000) 100000)
    ((= place 100000) 10000)
    ((= place 10000) 1000)
    ((= place 1000) 100)
    ((= place 100) 10)
    ((= place 10) 1)
    (t 1)))

(defun native_ir_dump_first_place (value place)
  (declare (type u64 value place) (returns u64))
  (if (= place 1) place
      (if (< value place) (native_ir_dump_first_place value (native_ir_dump_place place)) place)))

(defun native_ir_dump_digit (dump value place digit)
  (declare (type (ptr native_ir_dump) dump) (type u64 value place)
           (type u8 digit) (returns u64))
  (if (< value place)
      (progn (native_ir_dump_byte dump (wrap+ digit 48)) value)
      (native_ir_dump_digit dump (wrap- value place) place (wrap+ digit 1))))

(defun native_ir_dump_digits (dump value place)
  (declare (type (ptr native_ir_dump) dump) (type u64 value place) (returns c-int))
  (let ((remainder (native_ir_dump_digit dump value place 0)))
    (if (= place 1) 1 (native_ir_dump_digits dump remainder (native_ir_dump_place place)))))

(defun native_ir_dump_number (dump value)
  (declare (type (ptr native_ir_dump) dump) (type u64 value) (returns c-int))
  (native_ir_dump_digits dump value (native_ir_dump_first_place value 10000000000000000000)))

(defun native_ir_dump_field (dump label value)
  (declare (type (ptr native_ir_dump) dump) (type (ptr u8) label)
           (type u64 value) (returns c-int))
  (native_ir_dump_text dump label)
  (native_ir_dump_number dump value))

