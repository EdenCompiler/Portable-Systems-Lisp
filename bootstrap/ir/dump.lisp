(defun native_ir_dump_type (code)
  (declare (type u32 code) (returns (ptr u8)))
  (cond
    ((= code 0) (ffi:c-string "BOOLEAN"))
    ((= code 1) (ffi:c-string "U64"))
    ((= code 2) (ffi:c-string "USIZE"))
    ((= code 3) (ffi:c-string "U8"))
    ((= code 4) (ffi:c-string "U16"))
    ((= code 5) (ffi:c-string "U32"))
    ((= code 6) (ffi:c-string "S8"))
    ((= code 7) (ffi:c-string "S16"))
    ((= code 8) (ffi:c-string "S32"))
    ((= code 9) (ffi:c-string "S64"))
    ((= code 10) (ffi:c-string "ISIZE"))
    ((= code 11) (ffi:c-string "POINTER"))
    ((= code 12) (ffi:c-string "VOID"))
    ((= code 13) (ffi:c-string "F32"))
    ((= code 14) (ffi:c-string "F64"))
    ((= code 15) (ffi:c-string "VALUE"))
    ((= code 16) (ffi:c-string "RECORD"))
    (t (ffi:c-string "UNKNOWN"))))

(defun native_ir_dump_function_name (context dump)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (returns c-int))
  (let ((signature (deref (field-pointer context 'current_signature))))
    (if (= (deref (field-pointer signature 'generated)) 1)
        (progn
          (native_ir_dump_text dump (ffi:c-string "LAMBDA#"))
          (native_ir_dump_number dump
            (wrap-cast u64 (deref (field-pointer signature 'generated_plan)))))
        (let ((name (parser_node (deref (field-pointer context 'parser))
                                (deref (field-pointer signature 'name)))))
          (native_ir_dump_span dump
            (pointer+ (deref (field-pointer context 'source))
                      (wrap-cast isize (deref (field-pointer name 'start))))
            (deref (field-pointer name 'length)))))))

(defun native_ir_dump_header (context dump stage)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (type (ptr u8) stage) (returns c-int))
  (native_ir_dump_text dump stage)
  (native_ir_dump_byte dump 32)
  (native_ir_dump_function_name context dump)
  (native_ir_dump_byte dump 10))

(defun native_ir_dump_value (dump kind code value pointee source left right target)
  (declare (type (ptr native_ir_dump) dump) (type u32 kind code)
           (type u64 value) (type usize pointee source left right target) (returns c-int))
  (native_ir_dump_text dump (native_ir_dump_operation kind))
  (if (< kind 100)
      (progn (native_ir_dump_text dump (ffi:c-string " :"))
             (native_ir_dump_text dump (native_ir_dump_type code)))
      (wrap-cast c-int 1))
  (native_ir_dump_field dump (ffi:c-string " kind=") (wrap-cast u64 kind))
  (native_ir_dump_field dump (ffi:c-string " value=") value)
  (native_ir_dump_field dump (ffi:c-string " left=") (wrap-cast u64 left))
  (native_ir_dump_field dump (ffi:c-string " right=") (wrap-cast u64 right))
  (native_ir_dump_field dump (ffi:c-string " target=") (wrap-cast u64 target))
  (native_ir_dump_field dump (ffi:c-string " pointee=") (wrap-cast u64 pointee))
  (native_ir_dump_field dump (ffi:c-string " source=") (wrap-cast u64 source))
  (native_ir_dump_byte dump 10))

(defun native_ir_dump_hir_nodes (context dump index)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (type usize index) (returns c-int))
  (let ((arena (deref (field-pointer context 'hir))))
    (if (< (deref (field-pointer arena 'count)) index) 1
        (let ((node (hir_node_at arena index)))
          (native_ir_dump_field dump (ffi:c-string "  %") (wrap-cast u64 index))
          (native_ir_dump_text dump (ffi:c-string " = "))
          (native_ir_dump_value dump
            (deref (field-pointer node 'kind))
            (deref (field-pointer node 'scalar_code))
            (deref (field-pointer node 'value))
            (deref (field-pointer node 'pointee))
            (deref (field-pointer node 'source))
            (deref (field-pointer node 'left))
            (deref (field-pointer node 'right))
            (deref (field-pointer node 'target)))
          (native_ir_dump_hir_nodes context dump (wrap+ index 1))))))

(defun native_ir_dump_ssa_nodes (context dump index)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (type usize index) (returns c-int))
  (let ((arena (deref (field-pointer context 'ssa))))
    (if (< (deref (field-pointer arena 'value_count)) index) 1
        (let ((node (ssa_value_at arena index)))
          (native_ir_dump_field dump (ffi:c-string "  %") (wrap-cast u64 index))
          (native_ir_dump_field dump (ffi:c-string " block=") (wrap-cast u64 (deref (field-pointer node 'block))))
          (native_ir_dump_field dump (ffi:c-string " predecessor_left=") (wrap-cast u64 (deref (field-pointer node 'predecessor_left))))
          (native_ir_dump_field dump (ffi:c-string " predecessor_right=") (wrap-cast u64 (deref (field-pointer node 'predecessor_right))))
          (native_ir_dump_field dump (ffi:c-string " live=") (wrap-cast u64 (deref (field-pointer node 'live))))
          (native_ir_dump_text dump (ffi:c-string " = "))
          (native_ir_dump_value dump
            (deref (field-pointer node 'kind))
            (deref (field-pointer node 'scalar_code))
            (deref (field-pointer node 'value))
            (deref (field-pointer node 'pointee))
            (deref (field-pointer node 'source))
            (deref (field-pointer node 'left))
            (deref (field-pointer node 'right))
            (deref (field-pointer node 'target)))
          (native_ir_dump_ssa_nodes context dump (wrap+ index 1))))))

(defun native_ir_dump_lir_nodes (context dump index)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (type usize index) (returns c-int))
  (let ((arena (deref (field-pointer context 'lir))))
    (if (< (deref (field-pointer arena 'count)) index) 1
        (let ((node (lir_instruction_at arena index)))
          (native_ir_dump_field dump (ffi:c-string "  %") (wrap-cast u64 index))
          (native_ir_dump_field dump (ffi:c-string " destination=") (wrap-cast u64 (deref (field-pointer node 'destination))))
          (native_ir_dump_text dump (ffi:c-string " = "))
          (native_ir_dump_value dump
            (deref (field-pointer node 'kind))
            (deref (field-pointer node 'scalar_code))
            (deref (field-pointer node 'value))
            (deref (field-pointer node 'pointee))
            (deref (field-pointer node 'source))
            (deref (field-pointer node 'left))
            (deref (field-pointer node 'right))
            (deref (field-pointer node 'target)))
          (native_ir_dump_lir_nodes context dump (wrap+ index 1))))))

(defun native_ir_dump_ssa_blocks (context dump index)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (type usize index) (returns c-int))
  (let ((arena (deref (field-pointer context 'ssa))))
    (if (< (deref (field-pointer arena 'block_count)) index) 1
        (let ((block (ssa_block_at arena index)))
          (native_ir_dump_field dump (ffi:c-string "  b") (wrap-cast u64 index))
          (native_ir_dump_text dump (cond
            ((= (deref (field-pointer block 'terminator)) 1) (ffi:c-string " RETURN"))
            ((= (deref (field-pointer block 'terminator)) 2) (ffi:c-string " JUMP"))
            (t (ffi:c-string " BRANCH"))))
          (native_ir_dump_field dump (ffi:c-string " condition=") (wrap-cast u64 (deref (field-pointer block 'condition))))
          (native_ir_dump_field dump (ffi:c-string " result=") (wrap-cast u64 (deref (field-pointer block 'result))))
          (native_ir_dump_field dump (ffi:c-string " target_left=") (wrap-cast u64 (deref (field-pointer block 'target_left))))
          (native_ir_dump_field dump (ffi:c-string " target_right=") (wrap-cast u64 (deref (field-pointer block 'target_right))))
          (native_ir_dump_byte dump 10)
          (native_ir_dump_ssa_blocks context dump (wrap+ index 1))))))

(defun native_ir_dump_render (context dump)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (returns c-int))
  (let ((stages (deref (field-pointer dump 'stages))))
    (if (= (bits-and stages 1) 0) (wrap-cast c-int 1)
        (progn (native_ir_dump_header context dump (ffi:c-string "HIR"))
               (native_ir_dump_hir_nodes context dump 1)))
    (if (= (bits-and stages 2) 0) (wrap-cast c-int 1)
        (progn (native_ir_dump_header context dump (ffi:c-string "SSA"))
               (native_ir_dump_ssa_nodes context dump 1)
               (native_ir_dump_ssa_blocks context dump 1)))
    (if (= (bits-and stages 4) 0) (wrap-cast c-int 1)
        (progn (native_ir_dump_header context dump (ffi:c-string "LIR"))
               (native_ir_dump_field dump (ffi:c-string "  roots=")
                 (wrap-cast u64 (deref (field-pointer (deref (field-pointer context 'lir)) 'root_count))))
               (native_ir_dump_byte dump 10)
               (native_ir_dump_lir_nodes context dump 1)))
    1))

(defun native_ir_dump_validate (context root stages)
  (declare (type (ptr native_compile_context) context) (type usize root)
           (type u32 stages) (returns c-int))
  (if (if (= (bits-and stages 1) 0) t
          (= (hir_verify_typed_function context root) 1))
      (if (if (= (bits-and stages 2) 0) t (= (ssa_verify_function context) 1))
          (if (= (bits-and stages 4) 0) 1 (lir_verify_function context)) 0) 0))

(defun native_ir_dump_generated_header_p (context signature)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_signature) signature) (returns c-int))
  (let ((reference (deref (field-pointer signature 'generated_plan))))
    (if (= reference 0) 0
        (if (< (deref (field-pointer context 'closure_plan_count)) reference) 0
            (if (= (ptr-address (deref (field-pointer context 'closure_plans))) 0) 0
                (let ((plan (pointer+ (deref (field-pointer context 'closure_plans))
                                     (wrap-cast isize (wrap- reference 1)))))
                  (if (= (deref (field-pointer plan 'origin))
                         (deref (field-pointer signature 'generated_origin)))
                      (if (= (deref (field-pointer plan 'argument))
                             (deref (field-pointer signature 'generated_argument)))
                          (if (= (deref (field-pointer plan 'body))
                                 (deref (field-pointer signature 'generated_body))) 1 0) 0) 0)))))))

(defun native_ir_dump_source_header_p (context signature parser)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_signature) signature) (type (ptr psl_parser) parser)
           (returns c-int))
  (let ((name (deref (field-pointer signature 'name)))
        (scanner (deref (field-pointer parser 'scanner))))
    (if (= (ptr-address scanner) 0) 0
        (if (= (ir_reference_p name (deref (field-pointer parser 'count))) 0) 0
            (let ((node (parser_node parser name)))
              (if (= (deref (field-pointer node 'kind)) 8)
                  (if (< (deref (field-pointer scanner 'length))
                         (deref (field-pointer node 'start))) 0
                      (if (< (wrap- (deref (field-pointer scanner 'length))
                                    (deref (field-pointer node 'start)))
                             (deref (field-pointer node 'length))) 0 1)) 0))))))

(defun native_ir_dump_header_valid_p (context)
  (declare (type (ptr native_compile_context) context) (returns c-int))
  (let ((parser (deref (field-pointer context 'parser)))
        (signature (deref (field-pointer context 'current_signature))))
    (if (= (ptr-address parser) 0) 0
        (if (= (ptr-address signature) 0) 0
            (if (= (ptr-address (deref (field-pointer context 'source))) 0) 0
                (if (= (deref (field-pointer signature 'generated)) 1)
                    (native_ir_dump_generated_header_p context signature)
                    (native_ir_dump_source_header_p context signature parser)))))))

(defun native_ir_dump_write (context dump)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (returns c-int))
  (let ((output (deref (field-pointer dump 'output))))
    (store (field-pointer dump 'writing) 1)
    (store (field-pointer dump 'cursor) (deref (field-pointer output 'length)))
    (native_ir_dump_render context dump)
    (store (field-pointer output 'length) (deref (field-pointer dump 'cursor)))
    1))

(defun native_ir_dump_sized (context dump)
  (declare (type (ptr native_compile_context) context)
           (type (ptr native_ir_dump) dump) (returns c-int))
  (let ((output (deref (field-pointer dump 'output))))
    (store (field-pointer dump 'error) 0)
    (store (field-pointer dump 'writing) 0)
    (store (field-pointer dump 'cursor) (deref (field-pointer output 'length)))
    (native_ir_dump_render context dump)
    (store (field-pointer dump 'required) (deref (field-pointer dump 'cursor)))
    (if (< 0 (deref (field-pointer dump 'error))) 0
        (if (< (deref (field-pointer output 'capacity)) (deref (field-pointer dump 'required)))
            (progn (store (field-pointer dump 'error) 2) 0)
            (if (= (ptr-address (deref (field-pointer output 'data))) 0)
                (progn (store (field-pointer dump 'error) 1) 0)
                (native_ir_dump_write context dump))))))

(defun native_ir_dump_function (context root dump)
  (declare (type (ptr native_compile_context) context) (type usize root)
           (type (ptr native_ir_dump) dump) (returns c-int) (c-export :c))
  (if (= (ptr-address dump) 0) 0
      (progn
        (store (field-pointer dump 'error) 1)
        (store (field-pointer dump 'required) 0)
        (if (= (ptr-address context) 0) 0
            (if (= (ptr-address (deref (field-pointer dump 'output))) 0) 0
                (let ((output (deref (field-pointer dump 'output)))
                      (stages (deref (field-pointer dump 'stages))))
                  (if (if (= stages 0) t (< 7 stages)) 0
                      (if (< (deref (field-pointer output 'capacity)) (deref (field-pointer output 'length))) 0
                          (if (= (native_ir_dump_header_valid_p context) 0) 0
                              (if (= (native_ir_dump_validate context root stages) 0) 0
                                  (native_ir_dump_sized context dump)))))))))))
