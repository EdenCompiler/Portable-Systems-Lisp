    ((= code 2) (ffi:c-string "PARAMETER"))
    ((= code 4) (ffi:c-string "WRAP+"))
    ((= code 5) (ffi:c-string "WRAP-"))
    ((= code 6) (ffi:c-string "WRAP*"))
    ((= code 7) (ffi:c-string "CALL"))
    ((= code 8) (ffi:c-string "="))
    ((= code 9) (ffi:c-string "<"))
    ((= code 10) (ffi:c-string "IF"))
    ((= code 11) (ffi:c-string "BITS-AND"))
    ((= code 12) (ffi:c-string "SHR64"))
    ((= code 13) (ffi:c-string "SEQUENCE"))
    ((= code 14) (ffi:c-string "BIND"))
    ((= code 15) (ffi:c-string "LOCAL"))
    ((= code 16) (ffi:c-string "LET"))
    ((= code 17) (ffi:c-string "ARGUMENT"))
    ((= code 18) (ffi:c-string "CAST"))
    ((= code 19) (ffi:c-string "BOOLEAN"))
    ((= code 20) (ffi:c-string "TRUTH"))
    ((= code 21) (ffi:c-string "POINTER-FROM-ADDRESS"))
    ((= code 22) (ffi:c-string "POINTER-CAST"))
    ((= code 23) (ffi:c-string "FIELD-POINTER"))
    ((= code 24) (ffi:c-string "LOAD"))
    ((= code 25) (ffi:c-string "STORE"))
    ((= code 26) (ffi:c-string "WHILE"))
    ((= code 27) (ffi:c-string "POINTER+"))
    ((= code 28) (ffi:c-string "PHI"))
    ((= code 29) (ffi:c-string "VOID"))
    ((= code 30) (ffi:c-string "POINTER-ADDRESS"))
    ((= code 31) (ffi:c-string "COPY"))
    ((= code 34) (ffi:c-string "DATA-ADDRESS"))
    ((= code 35) (ffi:c-string "LITERAL-ADDRESS"))
    ((= code 36) (ffi:c-string "FUNCTION-ADDRESS"))
    ((= code 110) (ffi:c-string "ROOT-INIT"))
    ((= code 111) (ffi:c-string "ROOT-PUSH"))
    ((= code 112) (ffi:c-string "ROOT-SYNC"))
    ((= code 113) (ffi:c-string "ROOT-POP"))
    ((= code 100) (ffi:c-string "LABEL"))
    ((= code 101) (ffi:c-string "JUMP"))
    ((= code 102) (ffi:c-string "BRANCH"))
    ((= code 103) (ffi:c-string "RETURN"))
    ((= code 104) (ffi:c-string "COPY"))
