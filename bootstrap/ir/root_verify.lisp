;; Canonical placement proves the lifetime across every verified CFG path:
;; one entry initialization/push, no edges back to entry, and each pop directly
;; followed by a return. Managed argument reads may occur anywhere in the body.
(defun native_root_target_p (context target id)
  (declare (type (ptr native_compile_context) context) (type usize target) (type u32 id) (returns c-int))
  (if (= (ir_reference_p target (deref (field-pointer context 'prior_count))) 0) 0
      (let ((signature (native_signature_at (deref (field-pointer context 'signatures)) (wrap- target 1))))
        (if (= (deref (field-pointer signature 'runtime_id)) id)
            (native_runtime_signature_p context signature) 0))))

(defun native_root_control_target_p (context op)
  (declare (type (ptr native_compile_context) context) (type (ptr native_lir_instruction) op) (returns c-int))
  (let ((kind (deref (field-pointer op 'kind))) (target (deref (field-pointer op 'target))))
    (cond ((= kind 111) (native_root_target_p context target 7))
          ((= kind 113) (native_root_target_p context target 8))
          (t (if (= target 0) 1 0)))))

(defun native_root_control_shape_p (context op)
  (declare (type (ptr native_compile_context) context) (type (ptr native_lir_instruction) op) (returns c-int))
  (if (= (deref (field-pointer op 'destination)) 0)
      (if (= (deref (field-pointer op 'scalar_code)) 0)
          (if (= (deref (field-pointer op 'pointee)) 0)
              (if (= (deref (field-pointer op 'source)) 0)
                  (if (= (deref (field-pointer op 'value)) 0)
                      (if (= (deref (field-pointer op 'left)) 0)
                          (if (= (deref (field-pointer op 'right)) 0)
                              (native_root_control_target_p context op) 0) 0) 0) 0) 0) 0) 0))

(defun native_root_previous_kind_p (arena index kind)
  (declare (type (ptr native_lir_arena) arena) (type usize index) (type u32 kind) (returns c-int))
  (if (< 1 index)
      (if (= (deref (field-pointer (lir_instruction_at arena (wrap- index 1)) 'kind)) kind) 1 0) 0))

(defun native_root_next_kind_p (arena index kind)
  (declare (type (ptr native_lir_arena) arena) (type usize index) (type u32 kind) (returns c-int))
  (if (< index (deref (field-pointer arena 'count)))
      (if (= (deref (field-pointer (lir_instruction_at arena (wrap+ index 1)) 'kind)) kind) 1 0) 0))

(defun native_root_instruction_lifetime_p (context index)
  (declare (type (ptr native_compile_context) context) (type usize index) (returns c-int))
  (let ((arena (deref (field-pointer context 'lir))))
    (let ((op (lir_instruction_at arena index)))
      (let ((kind (deref (field-pointer op 'kind))))
        (cond
          ((= index 2) (if (= kind 110) 1 0))
          ((= index 3) (if (= kind 111) 1 0))
          ((= kind 110) 0) ((= kind 111) 0)
          ((= kind 7) (native_root_previous_kind_p arena index 112))
          ((= kind 103) (native_root_previous_kind_p arena index 113))
          ((= kind 112) (native_root_next_kind_p arena index 7))
          ((= kind 113) (native_root_next_kind_p arena index 103))
          ((= kind 101) (if (= (deref (field-pointer op 'target)) 1) 0 1))
          ((= kind 102)
           (if (= (deref (field-pointer op 'target)) 1) 0
               (if (= (deref (field-pointer op 'right)) 1) 0 1)))
          (t 1))))))

(defun native_root_verify_lifetime (context)
  (declare (type (ptr native_compile_context) context) (returns c-int))
  (let ((arena (deref (field-pointer context 'lir))))
    (store (field-pointer context 'root_cursor) 1)
    (store (field-pointer context 'root_flags) 0)
    (while (if (= (deref (field-pointer context 'root_flags)) 0)
               (< (deref (field-pointer context 'root_cursor)) (wrap+ (deref (field-pointer arena 'count)) 1)) nil)
      (if (= (native_root_instruction_lifetime_p context (deref (field-pointer context 'root_cursor))) 0)
          (store (field-pointer context 'root_flags) 1) (wrap-cast u32 0))
      (store (field-pointer context 'root_cursor) (wrap+ (deref (field-pointer context 'root_cursor)) 1)))
    (if (= (deref (field-pointer context 'root_flags)) 0) 1 0)))

(defun native_root_verify_empty (context)
  (declare (type (ptr native_compile_context) context) (returns c-int))
  (let ((arena (deref (field-pointer context 'lir))))
    (store (field-pointer context 'root_cursor) 1)
    (store (field-pointer context 'root_flags) 0)
    (while (if (= (deref (field-pointer context 'root_flags)) 0)
               (< (deref (field-pointer context 'root_cursor)) (wrap+ (deref (field-pointer arena 'count)) 1)) nil)
      (if (= (native_root_kind_p (deref (field-pointer (lir_instruction_at arena
                    (deref (field-pointer context 'root_cursor))) 'kind))) 1)
          (store (field-pointer context 'root_flags) 1) (wrap-cast u32 0))
      (store (field-pointer context 'root_cursor) (wrap+ (deref (field-pointer context 'root_cursor)) 1)))
    (if (= (deref (field-pointer context 'root_flags)) 0) 1 0)))

(defun native_verify_root_catalogue (context)
  (declare (type (ptr native_compile_context) context) (returns c-int) (c-export :c))
  (let ((arena (deref (field-pointer context 'lir))) (required (native_root_required_count context)))
    (if (= (deref (field-pointer arena 'root_count)) required)
        (if (= required 0) (native_root_verify_empty context)
            (if (= (deref (field-pointer context 'profile)) 1)
                (if (< (deref (field-pointer arena 'count)) 4) 0
                    (native_root_verify_lifetime context)) 0)) 0)))

(defun native_verify_roots (context)
 (declare (type (ptr native_compile_context) context) (returns c-int))
 (if (= (native_root_parameters_p context) 0) 0 (native_verify_root_catalogue context)))
