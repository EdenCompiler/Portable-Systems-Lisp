;; Until root-frame lowering lands, reject every collecting call in a function
;; whose verified value catalogue contains managed words. Unknown calls collect.
(defun native_lir_has_managed_p (context)
  (declare (type (ptr native_compile_context) context) (returns c-int))
  (let ((arena (deref (field-pointer context 'lir))))
    (store (field-pointer context 'fold_cursor) 1)
    (store (field-pointer context 'fold_changed) 0)
    (while (if (= (deref (field-pointer context 'fold_changed)) 0)
               (< (deref (field-pointer context 'fold_cursor))
                  (wrap+ (deref (field-pointer arena 'value_count)) 1)) nil)
      (let ((type (ir_type_at (deref (field-pointer arena 'types))
                             (deref (field-pointer context 'fold_cursor)))))
        (if (= (deref (field-pointer type 'scalar_code)) 15)
            (store (field-pointer context 'fold_changed) 1)
            (progn (store (field-pointer context 'fold_cursor)
                          (wrap+ (deref (field-pointer context 'fold_cursor)) 1))
                   (wrap-cast c-int 0)))))
    (wrap-cast c-int (deref (field-pointer context 'fold_changed)))))

(defun native_lir_managed_safe_p (context)
  (declare (type (ptr native_compile_context) context) (returns c-int) (c-export :c))
  (if (= (native_lir_has_managed_p context) 0) 1
      (let ((arena (deref (field-pointer context 'lir))))
        (store (field-pointer context 'fold_cursor) 1)
        (store (field-pointer context 'fold_changed) 0)
        (while (if (= (deref (field-pointer context 'fold_changed)) 0)
                   (< (deref (field-pointer context 'fold_cursor))
                      (wrap+ (deref (field-pointer arena 'count)) 1)) nil)
          (let ((op (lir_instruction_at arena (deref (field-pointer context 'fold_cursor)))))
            (if (= (deref (field-pointer op 'kind)) 7)
                (if (= (hir_call_allocation_free_p context (deref (field-pointer op 'target)) 1) 0)
                    (store (field-pointer context 'fold_changed) 1) (wrap-cast c-int 0))
                (wrap-cast c-int 0)))
          (store (field-pointer context 'fold_cursor)
                 (wrap+ (deref (field-pointer context 'fold_cursor)) 1)))
        (if (= (deref (field-pointer context 'fold_changed)) 0) 1 0))))
