(include "types.lisp")
(defun native_ct_package_at (env reference)
  (declare (type (ptr native_ct_environment) env) (type usize reference)
           (returns (ptr native_ct_package)))
  (pointer+ (deref (field-pointer env 'packages)) (wrap-cast isize (wrap- reference 1))))
(defun native_ct_symbol_at (env reference)
  (declare (type (ptr native_ct_environment) env) (type usize reference)
           (returns (ptr native_ct_symbol)))
  (pointer+ (deref (field-pointer env 'symbols)) (wrap-cast isize (wrap- reference 1))))
