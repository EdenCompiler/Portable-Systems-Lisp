;; Constant recognition reads the actual symbol owner and stored name. It does
;; not intern scratch spellings or require spare name-arena capacity.
(defun native_macro_constant_bytes_p (env symbol first second third fourth fifth length index)
  (declare (type (ptr native_ct_environment) env)
           (type (ptr native_ct_symbol) symbol)
           (type u64 first second third fourth fifth)
           (type usize length index) (returns c-int))
  (if (= index length) 1
      (if (= (deref (pointer+ (deref (field-pointer env 'names))
                      (wrap-cast isize (wrap+ (deref (field-pointer symbol 'name)) index))))
             (native_ct_seed_word_byte first second third fourth fifth index))
          (native_macro_constant_bytes_p env symbol first second third fourth fifth length (wrap+ index 1))
          0)))

(defun native_macro_cl_constant_word_p (parser reference package first second third fourth fifth length)
  (declare (type (ptr psl_parser) parser) (type usize reference package length)
           (type u64 first second third fourth fifth) (returns c-int))
  (let ((reader (deref (field-pointer parser 'environment))))
    (let ((identity (ast_symbol_identity parser reference))
          (env (deref (field-pointer reader 'environment))))
      (if (= (native_ct_symbol_valid_p env identity) 0) 0
          (let ((symbol (native_ct_symbol_at env identity)))
            (if (= (deref (field-pointer symbol 'package)) package)
                (if (= (deref (field-pointer symbol 'length)) length)
                    (if (< (deref (field-pointer env 'name_count))
                           (deref (field-pointer symbol 'name))) 0
                        (if (< (wrap- (deref (field-pointer env 'name_count))
                                      (deref (field-pointer symbol 'name))) length) 0
                            (native_macro_constant_bytes_p env symbol first second third fourth fifth length 0)))
                    0) 0))))))

