(include "bindings.lisp")

(defun native_macro_tree (call)
  (declare (type (ptr native_macro_call) call) (returns (ptr native_tree_context)))
  (deref (field-pointer (deref (field-pointer call 'registry)) 'tree)))

(defun native_macro_copy_form (call reference preserve)
  (declare (type (ptr native_macro_call) call) (type usize reference)
           (type c-int preserve) (returns usize))
  (let ((tree (native_macro_tree call)))
    (let ((origin (deref (field-pointer tree 'origin))))
      (store (field-pointer tree 'origin)
             (if (= preserve 1) (wrap-cast usize 0) (deref (field-pointer call 'origin))))
      (let ((copy (native_tree_copy tree reference)))
        (store (field-pointer tree 'origin) origin)
        (if (= copy 0) (native_macro_call_fail call (deref (field-pointer tree 'error))) copy)))))

(defun native_macro_eval_atom (call reference)
  (declare (type (ptr native_macro_call) call) (type usize reference) (returns usize))
  (let ((symbol (ast_symbol_identity (native_macro_call_parser call) reference)))
    (let ((bound (native_macro_bound_form call symbol)))
      (if (< 0 bound) (native_macro_copy_form call bound 1)
          (let ((env (deref (field-pointer (deref (field-pointer (native_macro_call_parser call) 'environment)) 'environment))))
            (if (if (= symbol 0) t
                    (if (= symbol (deref (field-pointer env 'nil_symbol))) t
                        (= symbol (deref (field-pointer env 'true_symbol)))))
                (native_macro_copy_form call reference 0)
                (native_macro_call_fail call 4)))))))

(defun native_macro_new_template_node (call reference)
  (declare (type (ptr native_macro_call) call) (type usize reference) (returns usize))
  (let ((tree (native_macro_tree call)) (parser (native_macro_call_parser call)))
    (let ((reader (deref (field-pointer tree 'reader))))
      (if (< (deref (field-pointer parser 'count)) (deref (field-pointer reader 'capacity)))
          (let ((node (parser_node parser reference)))
            (let ((copy (parser_new_node parser (deref (field-pointer node 'kind))
                         (deref (field-pointer node 'start)) (deref (field-pointer node 'length)))))
              (if (= copy 0) (native_macro_call_fail call 1)
                  (progn (native_tree_copy_identity tree reference copy) copy))))
          (native_macro_call_fail call 1)))))

(defun native_macro_splice_children (call parent reference)
  (declare (type (ptr native_macro_call) call) (type usize parent reference) (returns c-int))
  (let ((tree (native_macro_tree call)) (parser (native_macro_call_parser call)))
    (store (field-pointer tree 'cursor) reference)
    (while (if (= (deref (field-pointer call 'error)) 0)
               (< 0 (deref (field-pointer tree 'cursor))) nil)
      (let ((child (deref (field-pointer tree 'cursor))))
        (let ((next (deref (field-pointer (parser_node parser child) 'next)))
              (copy (native_macro_copy_form call child 1)))
          (if (= copy 0) (wrap-cast usize 0) (parser_append parser parent copy))
          (store (field-pointer tree 'cursor) next))))
    (if (= (deref (field-pointer call 'error)) 0) 1 0)))

(defun native_macro_splice (call parent reference)
  (declare (type (ptr native_macro_call) call) (type usize parent reference) (returns c-int))
  (let ((parser (native_macro_call_parser call)))
    (let ((datum (native_macro_eval call (deref (field-pointer (parser_node parser reference) 'first)))))
      (if (= datum 0) 0
          (if (= (deref (field-pointer (parser_node parser datum) 'kind)) 1)
              (native_macro_splice_children call parent (deref (field-pointer (parser_node parser datum) 'first)))
              (if (= (ast_builtin_word_p parser (deref (field-pointer (deref (field-pointer call 'registry)) 'source))
                                         datum #x6c696e 0 3) 1) 1
                  (progn (native_macro_call_fail call 10) 0)))))))

(defun native_macro_qq_children (call parent reference level)
  (declare (type (ptr native_macro_call) call) (type usize parent reference)
           (type u32 level) (returns c-int))
  (let ((tree (native_macro_tree call)) (parser (native_macro_call_parser call)))
    (store (field-pointer tree 'cursor) reference)
    (while (if (= (deref (field-pointer call 'error)) 0)
               (< 0 (deref (field-pointer tree 'cursor))) nil)
      (let ((child (deref (field-pointer tree 'cursor))))
        (let ((next (deref (field-pointer (parser_node parser child) 'next)))
              (splice (if (= level 1) (= (deref (field-pointer (parser_node parser child) 'kind)) 6) nil)))
          (if splice
              (if (= (native_macro_splice call parent child) 1) (wrap-cast usize 1) (native_macro_call_fail call 10))
              (let ((copy (native_macro_qq_node call child level)))
                (if (= copy 0) (wrap-cast usize 0) (parser_append parser parent copy))))
          (store (field-pointer tree 'cursor) next))))
    (if (= (deref (field-pointer call 'error)) 0) 1 0)))

(defun native_macro_qq_construct (call reference level)
  (declare (type (ptr native_macro_call) call) (type usize reference)
           (type u32 level) (returns usize))
  (let ((parser (native_macro_call_parser call)))
    (let ((node (parser_node parser reference)))
      (let ((kind (deref (field-pointer node 'kind))))
        (cond
          ((if (= kind 5) (= level 1) nil)
           (native_macro_eval call (deref (field-pointer node 'first))))
          ((if (= kind 6) (= level 1) nil) (native_macro_call_fail call 10))
          (t (let ((copy (native_macro_new_template_node call reference)))
               (if (= copy 0) 0
                   (if (= (native_macro_qq_children call copy (deref (field-pointer node 'first))
                           (if (= kind 4) (wrap+ level 1)
                               (if (if (= kind 5) t (= kind 6)) (wrap- level 1) level))) 1)
                       copy (wrap-cast usize 0))))))))))

(defun native_macro_qq_node (call reference level)
  (declare (type (ptr native_macro_call) call) (type usize reference)
           (type u32 level) (returns usize))
  (let ((tree (native_macro_tree call)))
    (if (< 0 (deref (field-pointer call 'error))) 0
        (if (< (deref (field-pointer tree 'depth)) (deref (field-pointer tree 'limit)))
            (progn
              (store (field-pointer tree 'depth) (wrap+ (deref (field-pointer tree 'depth)) 1))
              (let ((copy (native_macro_qq_construct call reference level)))
                (store (field-pointer tree 'depth) (wrap- (deref (field-pointer tree 'depth)) 1))
                copy))
            (native_macro_call_fail call 5)))))

(defun native_macro_eval (call reference)
  (declare (type (ptr native_macro_call) call) (type usize reference) (returns usize))
  (let ((parser (native_macro_call_parser call)))
    (let ((node (parser_node parser reference)))
      (let ((kind (deref (field-pointer node 'kind))))
        (cond
          ((= kind 3) (native_macro_copy_form call (deref (field-pointer node 'first)) 0))
          ((= kind 4) (native_macro_qq_node call (deref (field-pointer node 'first)) 1))
          ((= kind 8) (native_macro_eval_atom call reference))
          ((= kind 7) (native_macro_copy_form call reference 0))
          (t (native_macro_call_fail call 10)))))))
