;; Build-host top-level macro registration for the compile-toplevel wrapper.
(include "functions.lisp")

(defun native_eval_when_form_p (context form)
  (declare (type (ptr native_compile_context) context) (type usize form) (returns c-int))
  (let ((parser (deref (field-pointer context 'parser)))
        (source (deref (field-pointer context 'source))))
    (let ((node (parser_node (deref (field-pointer context 'parser)) form)))
      (if (= (deref (field-pointer node 'kind)) 1)
          (ast_builtin_word_p parser source (deref (field-pointer node 'first))
                             #x6568772d6c617665 #x6e 9)
          (wrap-cast c-int 0)))))

(defun native_eval_when_compile_situation_p (context situations)
  (declare (type (ptr native_compile_context) context) (type usize situations) (returns c-int))
  (let ((parser (deref (field-pointer context 'parser)))
        (registry (field-pointer context 'macro_registry)))
    (let ((node (parser_node (deref (field-pointer context 'parser)) situations)))
      (if (= (deref (field-pointer node 'kind)) 1)
          (let ((situation (deref (field-pointer node 'first))))
            (if (if (= (ast_package_word_p parser situation 4
                                          #x2d656c69706d6f63 #x6c6576656c706f74 16) 1)
                    (= (native_macro_next registry situation) 0) nil)
                1 0))
          0))))

(defun native_collect_compile_eval_when (context form)
  (declare (type (ptr native_compile_context) context) (type usize form) (returns c-int))
  (let ((registry (field-pointer context 'macro_registry))
        (parser (deref (field-pointer context 'parser))))
    (let ((arguments (native_macro_next registry
                                        (deref (field-pointer (parser_node parser form) 'first))))
          (tree (deref (field-pointer registry 'tree))))
      (store (field-pointer registry 'error) 0)
      (if (= arguments 0)
          (progn (store (field-pointer registry 'error) 1) (wrap-cast c-int 0))
          (if (= (native_eval_when_compile_situation_p context arguments) 1)
              (progn (store (field-pointer tree 'cursor) (native_macro_next registry arguments))
                     (wrap-cast c-int 1))
              (progn (store (field-pointer registry 'error) 1) (wrap-cast c-int 0))))
      (while (if (= (deref (field-pointer registry 'error)) 0)
                 (< 0 (deref (field-pointer tree 'cursor))) nil)
        (let ((body (deref (field-pointer tree 'cursor))))
          (if (= (native_macro_definition_form_p context body) 1)
              (if (< 0 (native_macro_register registry body))
                  (progn (store (field-pointer tree 'cursor) (native_macro_next registry body))
                         (wrap-cast c-int 1))
                  (progn (store (field-pointer registry 'error) 1) (wrap-cast c-int 0)))
              (progn (store (field-pointer registry 'error) 1) (wrap-cast c-int 0)))))
      (if (= (deref (field-pointer registry 'error)) 0)
          (wrap-cast c-int 1) (wrap-cast c-int 0)))))
