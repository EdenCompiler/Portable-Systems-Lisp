(include "driver_types.lisp")
(include "../unit_types.lisp")
(include "c_source_types.lisp")

(defcstruct native_cli_options
  (source (ptr u8))
  (output (ptr u8))
  (optimization u32)
  (target u32)
  (profile u32)
  (kind u32)
  (emit_specified u32)
  (compile_only u32)
  (output_option u32)
  (paths usize)
  (cursor usize)
  (link_inputs (ptr (ptr u8)))
  (link_input_count usize)
  (link_input_capacity usize)
  (help_requested u32)
  (parse_error u32)
  (parse_error_text (ptr u8))
  (dump_stages u32))

(defcstruct native_compiler_state
  (driver native_driver)
  (result native_unit_result)
  (c_sources (ptr native_c_source_path))
  (optimization u32)
  (target u32)
  (profile u32)
  (link_input_storage (ptr (ptr u8)))
  (options native_cli_options)
  (ir_dump native_ir_dump)
  (ir_output byte_buffer))
