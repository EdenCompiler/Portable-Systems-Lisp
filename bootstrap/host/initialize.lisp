(defun native_initialize_context (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'context)))
    (store (field-pointer record 'parser) (field-pointer driver 'parser))
    (store (field-pointer record 'source) (deref (field-pointer driver 'source)))
    (store (field-pointer record 'integer) (field-pointer driver 'integer))
    (store (field-pointer record 'hir) (field-pointer driver 'hir))
    (store (field-pointer record 'code) (field-pointer driver 'code))
    (store (field-pointer record 'fixups) (field-pointer driver 'calls))
    (store (field-pointer record 'functions) (deref (field-pointer (field-pointer driver 'storage) 'functions)))
    (store (field-pointer record 'signatures) (field-pointer driver 'signature_context))
    (store (field-pointer record 'prior_count) 0)
    (store (field-pointer record 'current_arity) 0)
    (store (field-pointer record 'current_signature) (ptr-from-address (ptr native_signature) 0))
    (store (field-pointer record 'expected_type) 0)
    (store (field-pointer record 'active_binding) 0)
    (store (field-pointer record 'local_count) 0)
    (store (field-pointer record 'expected_pointee) 0)
    (store (field-pointer record 'ssa) (field-pointer driver 'ssa))
    (store (field-pointer record 'bindings) (deref (field-pointer (field-pointer driver 'storage) 'bindings)))
    (store (field-pointer record 'lir) (field-pointer driver 'lir))
    (store (field-pointer record 'labels) (deref (field-pointer (field-pointer driver 'storage) 'labels)))
    (store (field-pointer record 'jumps) (field-pointer driver 'jumps))
    (store (field-pointer record 'optimization) 1)
    (store (field-pointer record 'fold_cursor) 0)
    (store (field-pointer record 'fold_changed) 0)
    (store (field-pointer record 'effects_changed) 0)
    (store (field-pointer record 'inline_values) (deref (field-pointer (field-pointer driver 'storage) 'inline_values)))
    (store (field-pointer record 'inline_count) 0)
    (store (field-pointer record 'inline_capacity) capacity)
    (store (field-pointer record 'inline_cursor) 0)
    (store (field-pointer record 'target) 0)
    (store (field-pointer record 'backend_frame_size) 0)
    (store (field-pointer record 'backend_outgoing_size) 0)
    (store (field-pointer record 'backend_prologue_size) 0)
    (store (field-pointer record 'data_imports)
           (deref (field-pointer (field-pointer driver 'storage) 'data_imports)))
    (store (field-pointer record 'data_count) 0)
    (store (field-pointer record 'data_capacity) capacity)
    (store (field-pointer record 'data_bytes)
           (deref (field-pointer (field-pointer driver 'storage) 'data_bytes)))
    (store (field-pointer record 'data_byte_count) 0)
    (store (field-pointer record 'data_byte_capacity) capacity)
    (store (field-pointer record 'data_fixups) (field-pointer driver 'data_fixups))
    1))

(defun native_initialize_driver (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (native_initialize_scanner driver capacity)
  (native_initialize_token driver capacity)
  (native_initialize_parser driver capacity)
  (native_initialize_integer driver capacity)
  (native_initialize_shape driver capacity)
  (native_initialize_layouts driver capacity)
  (native_initialize_signature_context driver capacity)
  (native_initialize_hir driver capacity)
  (native_initialize_ssa driver capacity)
  (native_initialize_lir driver capacity)
  (native_initialize_calls driver capacity)
  (native_initialize_jumps driver capacity)
  (native_initialize_data_fixups driver capacity)
  (native_initialize_code driver capacity)
  (native_initialize_object driver capacity)
  (native_initialize_context driver capacity)
  1)
