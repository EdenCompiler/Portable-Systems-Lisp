(defun native_initialize_layouts (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'layouts)))
    (store (field-pointer record 'parser) (field-pointer driver 'parser))
    (store (field-pointer record 'source) (deref (field-pointer driver 'source)))
    (store (field-pointer record 'layouts) (deref (field-pointer (field-pointer driver 'storage) 'layouts)))
    (store (field-pointer record 'layout_count) 0)
    (store (field-pointer record 'layout_capacity) capacity)
    (store (field-pointer record 'fields) (deref (field-pointer (field-pointer driver 'storage) 'fields)))
    (store (field-pointer record 'field_count) 0)
    (store (field-pointer record 'field_capacity) capacity)
    (store (field-pointer record 'scratch) (field-pointer driver 'shape))
    (store (field-pointer record 'error) 0)
    1))

