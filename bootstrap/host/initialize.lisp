(include "driver_types.lisp")

;; Reset every logical field, including scalar scratch state and parser lookahead.

(defun native_initialize_scanner (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'scanner)))
    (store (field-pointer record 'data) (deref (field-pointer driver 'source)))
    (store (field-pointer record 'length) (deref (field-pointer driver 'length)))
    (store (field-pointer record 'cursor) 0)
    (store (field-pointer record 'error) 0)
    1))

(defun native_initialize_token (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'token)))
    (store (field-pointer record 'kind) 0)
    (store (field-pointer record 'start) 0)
    (store (field-pointer record 'length) 0)
    1))

(defun native_initialize_parser (driver capacity)
  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'parser)))
    (store (field-pointer record 'scanner) (field-pointer driver 'scanner))
    (store (field-pointer record 'token) (field-pointer driver 'token))
    (store (field-pointer record 'has_token) 0)
    (store (field-pointer record 'nodes) (deref (field-pointer (field-pointer driver 'storage) 'syntax)))
    (store (field-pointer record 'count) 0)
    (store (field-pointer record 'capacity) capacity)
    (store (field-pointer record 'error) 0)
    1))

