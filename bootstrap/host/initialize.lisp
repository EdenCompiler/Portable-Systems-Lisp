  (declare (type (ptr native_driver) driver) (type usize capacity)
           (returns c-int))
  (let ((record (field-pointer driver 'lir)))
    (store (field-pointer record 'instructions) (deref (field-pointer (field-pointer driver 'storage) 'lir)))
    (store (field-pointer record 'count) 0)
    (store (field-pointer record 'capacity) (wrap* capacity 6))
    (store (field-pointer record 'types) (deref (field-pointer (field-pointer driver 'storage) 'types)))
    (store (field-pointer record 'value_count) 0)
    (store (field-pointer record 'value_capacity) capacity)
    (store (field-pointer record 'blocks) (deref (field-pointer (field-pointer driver 'storage) 'lir_blocks)))
    (store (field-pointer record 'label_count) 0)
    (store (field-pointer record 'label_capacity) (wrap* capacity 3))
    (store (field-pointer record 'error) 0)
    1))

