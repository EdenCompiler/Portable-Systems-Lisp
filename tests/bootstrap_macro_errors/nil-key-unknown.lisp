(defmacro nil-key-only (&key ((nil value) 3)) value)
(defmacro nested-nil-key-expansion ()
  (macroexpand-1 '(nil-key-only :unrelated 8)))
(defun trigger-unknown-nil-key ()
  (declare (returns u64) (c-export :c))
  (nil-key-only :unrelated 8))
(defun trigger-nested-unknown-nil-key ()
  (declare (returns u64) (c-export :c))
  (nested-nil-key-expansion))
