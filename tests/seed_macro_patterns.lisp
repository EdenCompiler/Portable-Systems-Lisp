(defmacro seed-empty-pattern (()) 19)
(defmacro seed-nested-pattern ((left &optional (right 23)))
  (list 'wrap+ left right))
(defmacro seed-key-pattern (&key ((nil (left right)) '(19 23)))
  (list 'wrap+ left right))

(defun seed_empty_pattern ()
  (declare (returns u64) (c-export :c))
  (seed-empty-pattern ()))
(defun seed_nested_pattern ()
  (declare (returns u64) (c-export :c))
  (seed-nested-pattern (19)))
(defun seed_key_pattern ()
  (declare (returns u64) (c-export :c))
  (seed-key-pattern nil (19 23)))
