(ffi:import-function "nc_collect" () -> void)
(defmacro nc_lambda_form (captured)
  `(lambda (argument) (cons ,captured argument)))
(defun nc_identity (x)
  (declare (type value x) (returns value) (c-export :c))
  (funcall (lambda (argument) argument) x))
(defun nc_unused_machine (x)
  (declare (type value x) (returns value) (c-export :c))
  (let ((unused 123)) (funcall #'(lambda (argument) argument) x)))
(defun nc_make (a b c d)
  (declare (type value a b c d) (returns value) (c-export :c))
  #'(lambda (argument) (cons a (cons b (cons c (cons d argument))))))
(defun nc_call (closure argument)
  (declare (type value closure argument) (returns value) (c-export :c))
  (funcall closure argument))
(defun nc_collected (captured argument)
  (declare (type value captured argument) (returns value) (c-export :c))
  (let ((closure (function (lambda (item)
                            (ffi:call nc_collect)
                            (cons captured item)))))
    (ffi:call nc_collect) (funcall closure argument)))
(defun nc_shadow (x argument)
  (declare (type value x argument) (returns value) (c-export :c))
  (funcall #'(lambda (x) x) argument))
(defun nc_reserved_parameter (captured argument)
  (declare (type value captured argument) (returns value) (c-export :c))
  (funcall #'(lambda (%closure-environment)
               (cons captured %closure-environment))
           argument))
(defun nc_macro_capture (captured argument)
  (declare (type value captured argument) (returns value) (c-export :c))
  (funcall (nc_lambda_form captured) argument))
(defun nc_parallel ()
  (declare (returns value) (c-export :c))
  (let ((a "outer"))
    (let ((a "inner") (b a))
      (funcall (lambda (argument) (cons a (cons b argument))) nil))))
(defun nc_nested (a b x)
  (declare (type value a b x) (returns value) (c-export :c))
  (funcall #'(lambda (argument)
               (let ((local (cons argument a)))
                 #'(lambda (last) (cons local (cons b last)))))
           x))
(defun nc_local_shadow (a b argument)
  (declare (type value a b argument) (returns value) (c-export :c))
  (funcall #'(lambda (item)
               (let ((a b) (b a)) (cons a (cons b item))))
           argument))
