(load "src/load.lisp")
(let ((original (find-package "COMMON-LISP-USER")))
  (assert original)
  (assert (eq original (find-package "CL-USER")))
  (assert (equal (package-name original) "COMMON-LISP-USER"))
  (assert (equal (package-nicknames original) '("CL-USER")))
  (assert (member (find-package "CL") (package-use-list original)))
  (assert (not (member (find-package "PSL") (package-use-list original))))
  (multiple-value-bind (car status) (find-symbol "CAR" original)
    (assert (eq car 'cl:car))
    (assert (eq status :inherited)))
  (assert (null (find-symbol "WRAP+" original)))
  (assert (null (find-symbol "U64" original)))
  (assert (null (find-symbol "CL_USER_HELPER" original)))
  (multiple-value-bind (forms unit locations packages)
      (psl.frontend:read-source "tests/bootstrap_cl_user.lisp")
    (declare (ignore locations))
    (unwind-protect
         (let ((helper (find-symbol "CL_USER_HELPER" original)))
           (assert (= (length forms) 2))
           (assert (= (length packages) 1))
           (assert (member unit packages))
           (assert (eq (second (first forms)) helper))
           (assert (eq (first (third (fifth (second forms)))) helper))
           (assert (eq (find-symbol "U64" unit) (find-symbol "U64" :psl)))
           (assert (eq (find-symbol "WRAP+" unit) (find-symbol "WRAP+" :psl))))
      (psl.frontend:dispose-source-packages packages)))
  (assert (eq original (find-package "CL-USER")))
  (assert (find-symbol "CL_USER_HELPER" original)))
(format t "SBCL confirms pre-existing CL-USER package identity and visibility~%")
