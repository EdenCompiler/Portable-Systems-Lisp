(defun wa_identity_pair (x)
 (declare (type pair_record x) (returns pair_record)) x)
(defun wa_choose_pair (condition x y)
 (declare (type c-int condition) (type pair_record x y) (returns pair_record) (c-export :c))
 (let ((copy (if (= condition 0) x y))) (wa_identity_pair copy)))
(ffi:import-function "wa_next_pair" () -> pair_record :no-allocation)
(defun wa_pair_truth ()
 (declare (returns u64) (c-export :c))
 (if (ffi:call wa_next_pair) 42 0))
(ffi:import-function "wa_stack_c"
 ((a u64) (b u64) (c u64) (d u64) (e u64) (f u64) (g u64) (h u64) (x pair_record)) -> pair_record)
(defun wa_stack (a b c d e f g h x)
 (declare (type u64 a b c d e f g h) (type pair_record x) (returns pair_record) (c-export :c))
 (ffi:call wa_stack_c a b c d e f g h x))
(ffi:import-function "wa_mixed_c"
 ((a c-double) (b tiny_record) (c c-double) (d padded_record) (e u64)) -> padded_record)
(defun wa_mixed (a b c d e)
 (declare (type c-double a c) (type tiny_record b) (type padded_record d) (type u64 e)
          (returns padded_record) (c-export :c))
 (ffi:call wa_mixed_c a b c d e))
(defun wa_nested_second (p)
 (declare (type (ptr nested_record) p) (returns u16) (c-export :c))
 (deref (field-pointer (field-pointer p 'inner) 'second)))
(defun wa_padded_payload (p x)
 (declare (type (ptr padded_record) p) (type u32 x) (returns u32) (c-export :c))
 (store (field-pointer p 'payload) x))
