;; Natural C records with one-word opaque by-value storage.
(defcstruct byte_record (byte u8))
(defcstruct short_record (low s8) (high u8))
(defcstruct tiny_record (count u32))
(defcstruct word_record (bits u64))
(defcstruct pair_record (first u32) (second u32))
(defcstruct padded_record (tag u8) (payload u32))
(defcstruct pointer_record (address (ptr void)))
(defcstruct inner_record (first u16) (second u16))
(defcstruct nested_record (inner inner_record) (tail u32))
(defcstruct long_record (number c-long))

(ffi:import-function "wa_bump_byte_record" ((x byte_record)) -> byte_record :no-allocation)
(defun wa_pass_byte_record (x)
 (declare (type byte_record x) (returns byte_record) (c-export :c))
 (without-allocation (ffi:call wa_bump_byte_record x)))

(ffi:import-function "wa_bump_short_record" ((x short_record)) -> short_record :no-allocation)
(defun wa_pass_short_record (x)
