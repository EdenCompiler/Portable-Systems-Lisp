(defmacro nil-key-shape (&whole whole &rest tail &key ((nil value) 3 supplied))
  (if (and (= (length whole) 3)
           (= (length tail) 2)
           (eq (second whole) nil)
           supplied
           (= value 7))
      37
      99))
(defun nil_key_shape ()
  (declare (returns u64) (c-export :c))
  (nil-key-shape nil 7))
