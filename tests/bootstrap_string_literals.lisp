(ffi:import-function "sl_check" ((raw u64) (live value) (s value)) -> void)
(ffi:import-function "sl_step" () -> u64 :no-allocation)
(ffi:import-function "sl_note" ((s value)) -> void)
(defun sl_empty () (declare (returns value) (c-export :c)) "")
(defun sl_text () (declare (returns value) (c-export :c)) "a\"b\\c\nλ😀
Z")
(defun sl_same () (declare (returns value) (c-export :c)) "hello")
(defun sl_pair () (declare (returns value) (c-export :c)) (cons "hello" "world"))
(defun sl_live (raw live)
 (declare (type u64 raw) (type value live) (returns value) (c-export :c))
 (let ((s "hello")) (ffi:call sl_check raw live s) s))
(defun sl_loop () (declare (returns u64) (c-export :c))
 (while (< (ffi:call sl_step) 4097)
  (let ((s "hello")) (ffi:call sl_note s))) 42)
(defun sl_choice (flag) (declare (type u64 flag) (returns value) (c-export :c))
 (if (= flag 1) "hello" "world"))
(defun sl_utf8 () (declare (returns value) (c-export :c)) "߿ࠀ퟿￿𐀀􏿿")
