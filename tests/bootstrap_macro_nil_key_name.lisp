(defmacro nil-key-value (&key ((nil value) (if nil (error "default must stay lazy") 3) supplied))
  (list 'wrap+ value (if supplied 10 0)))
(defmacro nil-key-lazy (&key ((nil value) (if nil (error "default must stay lazy") 4) supplied))
  (list 'wrap+ value (if supplied 10 0)))
(defmacro nil-key-empty-name (&key ((() value) (if nil (error "default must stay lazy") 2) supplied))
  (list 'wrap+ value (if supplied 10 0)))
(defun nil_key_values ()
  (declare (returns u64) (c-export :c))
  (wrap+ (nil-key-value)
    (wrap+ (nil-key-value nil 7)
      (wrap+ (nil-key-value () 9)
        (wrap+ (nil-key-lazy nil 5)
          (wrap+ (nil-key-lazy () 6)
            (wrap+ (nil-key-value nil 7 nil 99)
              (wrap+ (nil-key-value :unrelated (error "ignored keyword value")
                         :allow-other-keys t)
                (wrap+ (nil-key-empty-name)
                  (wrap+ (nil-key-empty-name nil 3) (nil-key-empty-name () 4)))))))))))
