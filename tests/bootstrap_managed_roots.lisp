(ffi:import-function "rn_collect" () -> void)
(ffi:import-function "rn_check" ((raw u64) (live value)) -> void :no-allocation)
(defun rn_lazy (x)
 (declare (type value x) (returns value) (c-export :c))
 (collect-garbage) (car x))
(defun rn_raw (raw x)
 (declare (type u64 raw) (type value x) (returns u64) (c-export :c))
 (ffi:call rn_collect) (ffi:call rn_check raw x) raw)
(defun rn_float (x f)
 (declare (type value x) (type f64 f) (returns f64) (c-export :c))
 (ffi:call rn_collect) (ffi:call rn_check 1 x) f)
(defun rn_join (flag x)
 (declare (type u64 flag) (type value x) (returns value) (c-export :c))
 (collect-garbage) (if (< flag 1) (car x) (cdr x)))
(defun rn_recursive (n tail)
 (declare (type u64 n) (type value tail) (returns value) (c-export :c))
 (collect-garbage)
 (if (< n 1) tail (rn_recursive (wrap- n 1) (cons (box-fixnum (wrap-cast s64 n)) tail))))
(defun rn_stack (a b c d e f g h i j k l)
 (declare (type value a b c d e f g h i j k l) (returns value) (c-export :c))
 (collect-garbage) (cons a (cons l nil)))
(defun rn_mixed (f0 a f1 b f2 c f3 d f4 e f5 f f6 g f7 h f8 i)
 (declare (type f64 f0 f1 f2 f3 f4 f5 f6 f7 f8) (type value a b c d e f g h i) (returns f64) (c-export :c))
 (ffi:call rn_collect) (ffi:call rn_check 1 i) f8)
(ffi:import-function "rn_step" () -> u64 :no-allocation)
(ffi:import-function "rn_note" ((x value)) -> void)
(defun rn_loop ()
 (declare (returns u64) (c-export :c))
 (while (< (ffi:call rn_step) 4097)
  (let ((x (cons (box-fixnum 42) nil))) (ffi:call rn_note x))) 42)
