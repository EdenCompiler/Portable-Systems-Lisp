(ffi:import-function "sp_check" ((raw u64) (live value) (symbol value)) -> void)
(ffi:import-function "sp_step" () -> u64 :no-allocation)
(ffi:import-function "sp_note" ((symbol value)) -> void)
(defun sp_make (name) (declare (type value name) (returns value) (c-export :c))
 (cl:make-symbol name))
(defun sp_name (symbol) (declare (type value symbol) (returns value) (c-export :c))
 (without-allocation (cl:symbol-name symbol)))
(defun sp_package_name (package) (declare (type value package) (returns value) (c-export :c))
 (without-allocation (cl:package-name package)))
(defun sp_fresh () (declare (returns value) (c-export :c))
 (let ((name "Case")) (cons (make-symbol name) (make-symbol name))))
(defun sp_package () (declare (returns value) (c-export :c))
 (psl:make-package-from-name "Pkg"))
(defun sp_intern (package name) (declare (type value package name) (returns value) (c-export :c))
 (psl:intern-symbol package name))
(defun sp_graph () (declare (returns value) (c-export :c))
 (let ((package (make-package-from-name "Pkg")))
  (let ((a (intern-symbol package "Case")) (b (intern-symbol package "case")))
   (if (eq a (intern-symbol package "Case")) b nil))))
(defun sp_live (raw live) (declare (type u64 raw) (type value live) (returns value) (c-export :c))
 (let ((s (make-symbol "Keep"))) (ffi:call sp_check raw live s) s))
(defun sp_loop () (declare (returns u64) (c-export :c))
 (while (< (ffi:call sp_step) 4097)
  (let ((s (make-symbol "loop"))) (ffi:call sp_note s))) 42)
