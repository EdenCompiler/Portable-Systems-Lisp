(ffi:import-function "mv_order" ((which u64)) -> value)
(ffi:import-function "mv_collect" () -> void)
(ffi:import-function "mv_step" () -> u64 :no-allocation)
(ffi:import-function "mv_note" ((a value) (b value)) -> void)
(defun vm_first (a b) (declare (type value a b) (returns value) (c-export :c)) (values a b))
(defun vm_second (a b) (declare (type value a b) (returns value) (c-export :c))
 (multiple-value-bind (x y) (values a b) y))
(defun vm_order () (declare (returns s64) (c-export :c))
 (multiple-value-bind (a b) (values (ffi:call mv_order 1) (ffi:call mv_order 2))
  (wrap+ (unbox-fixnum a) (unbox-fixnum b))))
(defun vm_nested () (declare (returns s64) (c-export :c))
 (multiple-value-bind (a b) (values 19 23)
  (multiple-value-bind (a c) (values 99 100) (unbox-fixnum a))
  (wrap+ (unbox-fixnum a) (unbox-fixnum b))))
(defun vm_outer () (declare (returns s64) (c-export :c))
 (let ((a (box-fixnum 19)) (b (box-fixnum 23)))
  (multiple-value-bind (a b) (values b a) (wrap+ (unbox-fixnum a) (unbox-fixnum b)))))
(defun vm_live () (declare (returns value) (c-export :c))
 (multiple-value-bind (a b) (values "first" "second")
  (ffi:call mv_collect)
  (multiple-value-bind (a c) (values "inner" nil) a)
  (ffi:call mv_collect) (cons a b)))
(defun vm_loop () (declare (returns u64) (c-export :c))
 (while (< (ffi:call mv_step) 4097)
  (multiple-value-bind (a b) (values "first" "second") (ffi:call mv_note a b))) 42)
