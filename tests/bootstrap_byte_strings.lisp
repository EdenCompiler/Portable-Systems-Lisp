(ffi:import-function "bs_check" ((raw u64) (live value) (string value)) -> void)
(ffi:import-function "bs_step" () -> u64 :no-allocation)
(ffi:import-function "bs_note" ((string value)) -> void)
(defun bs_make (n fill)
 (declare (type usize n) (type u8 fill) (returns value) (c-export :c))
 (make-byte-string n fill))
(defun bs_read (s n)
 (declare (type value s) (type usize n) (returns u8) (c-export :c))
 (string-byte s n))
(defun bs_write (s n byte)
 (declare (type value s) (type usize n) (type u8 byte) (returns void) (c-export :c))
 (set-string-byte s n byte))
(defun bs_live (raw live)
 (declare (type u64 raw) (type value live) (returns value) (c-export :c))
 (let ((s (make-byte-string 257 65)))
  (set-string-byte s 0 255)
  (ffi:call bs_check raw live s) s))
(defun bs_loop ()
 (declare (returns u64) (c-export :c))
 (while (< (ffi:call bs_step) 4097)
  (let ((s (make-byte-string 7 255)))
   (set-string-byte s 6 0) (ffi:call bs_note s))) 42)
(defun bs_pair ()
 (declare (returns value) (c-export :c))
 (let ((s (make-byte-string 3 97))) (cons s nil)))
