(defun mv_identity (x)
  (declare (type value x) (returns value) (c-export :c)) x)
(defun mv_nil ()
  (declare (returns value) (c-export :c)) nil)
(defun mv_empty_nil ()
  (declare (returns value) (c-export :c)) ())
(defun mv_true ()
  (declare (returns value) (c-export :c)) t)
(defun mv_min ()
  (declare (returns value) (c-export :c)) -4611686018427387904)
(defun mv_max ()
  (declare (returns value) (c-export :c)) 4611686018427387903)
(defun mv_truth (x)
  (declare (type value x) (returns u64) (c-export :c))
  (if x 11 22))
(defun mv_zero_truth ()
  (declare (returns u64) (c-export :c)) (if 0 11 22))
(defun mv_eq_value (x y)
  (declare (type value x y) (returns value) (c-export :c)) (if (eq x y) t nil))
(defun mv_eq_branch (x y)
  (declare (type value x y) (returns u64) (c-export :c)) (if (eq x y) 11 22))
(defun mv_box (x)
  (declare (type s64 x) (returns value) (c-export :c)) (box-fixnum x))
(defun mv_unbox (x)
  (declare (type value x) (returns s64) (c-export :c)) (unbox-fixnum x))
(defun mv_car (x)
  (declare (type value x) (returns value) (c-export :c)) (car x))
(defun mv_cdr (x)
  (declare (type value x) (returns value) (c-export :c)) (cdr x))
(defun mv_recursive (n x)
  (declare (type u64 n) (type value x) (returns value) (c-export :c))
  (if (< n 1) x (mv_recursive (wrap- n 1) x)))
(defun mv_locals (x)
  (declare (type value x) (returns value) (c-export :c))
  (let ((saved (mv_identity x))) (if saved saved nil)))
(defun mv_stack (a b c d e f g h i j k l)
  (declare (type value a b c d e f g h i j k l) (returns value) (c-export :c))
  (if (eq a t) l k))

(ffi:import-function "mv_c_mixed"
  ((f0 f64) (v0 value) (f1 f64) (v1 value) (f2 f64) (v2 value) (f3 f64) (v3 value) (f4 f64) (v4 value) (f5 f64) (v5 value) (f6 f64) (v6 value) (f7 f64) (v7 value) (f8 f64) (v8 value)) -> value :no-allocation)
(defun mv_mixed (x)
  (declare (type value x) (returns value) (c-export :c))
  (ffi:call mv_c_mixed 1.0d0 x 2.0d0 1 3.0d0 2 4.0d0 3 5.0d0 4 6.0d0 5 7.0d0 6 8.0d0 7 9.0d0 x))
