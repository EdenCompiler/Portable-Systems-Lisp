(ffi:import-function "check_large"
  ((s0 f32) (d0 f64) (s1 f32) (d1 f64) (s2 f32) (d2 f64) (s3 f32) (d3 f64) (s4 f32) (d4 f64) (i0 u64) (i1 u64) (i2 u64) (i3 u64) (i4 u64) (i5 u64) (i6 u64) (i7 u64) (i8 u64)) -> f64)

(defun middle_abi (s0 d0 s1 d1 s2 d2 s3 d3 s4 d4 i0 i1 i2 i3 i4 i5 i6 i7 i8)
  (declare (type f32 s0)
           (type f64 d0)
           (type f32 s1)
           (type f64 d1)
           (type f32 s2)
           (type f64 d2)
           (type f32 s3)
           (type f64 d3)
           (type f32 s4)
           (type f64 d4)
           (type u64 i0)
           (type u64 i1)
           (type u64 i2)
           (type u64 i3)
           (type u64 i4)
           (type u64 i5)
           (type u64 i6)
           (type u64 i7)
           (type u64 i8)
           (returns f64))
  (ffi:call check_large s0 d0 s1 d1 s2 d2 s3 d3 s4 d4 i0 i1 i2 i3 i4 i5 i6 i7 i8))

(defun forward_abi (s0 d0 s1 d1 s2 d2 s3 d3 s4 d4 i0 i1 i2 i3 i4 i5 i6 i7 i8)
  (declare (type f32 s0)
           (type f64 d0)
           (type f32 s1)
           (type f64 d1)
           (type f32 s2)
           (type f64 d2)
           (type f32 s3)
           (type f64 d3)
           (type f32 s4)
           (type f64 d4)
           (type u64 i0)
           (type u64 i1)
           (type u64 i2)
           (type u64 i3)
           (type u64 i4)
           (type u64 i5)
           (type u64 i6)
           (type u64 i7)
           (type u64 i8)
           (returns f64) (c-export :c))
  (middle_abi s0 d0 s1 d1 s2 d2 s3 d3 s4 d4 i0 i1 i2 i3 i4 i5 i6 i7 i8))

(defun first_single (s0 d0 s1 d1 s2 d2 s3 d3 s4 d4 i0 i1 i2 i3 i4 i5 i6 i7 i8)
  (declare (type f32 s0)
           (type f64 d0)
           (type f32 s1)
           (type f64 d1)
           (type f32 s2)
           (type f64 d2)
           (type f32 s3)
           (type f64 d3)
           (type f32 s4)
           (type f64 d4)
           (type u64 i0)
           (type u64 i1)
           (type u64 i2)
           (type u64 i3)
           (type u64 i4)
           (type u64 i5)
           (type u64 i6)
           (type u64 i7)
           (type u64 i8)
           (returns f32) (c-export :c))
  s0)

(ffi:import-function "echo_single" ((x f32)) -> f32)
(ffi:import-function "echo_double" ((x f64)) -> f64)
(ffi:import-function "next_single" ((id c-int)) -> f32)
(ffi:import-function "ordered_pair" ((a f32) (b f32)) -> f64)
(defun single_roundtrip (x)
  (declare (type f32 x) (returns f32) (c-export :c))
  (ffi:call echo_single x))
(defun double_roundtrip (x)
  (declare (type f64 x) (returns f64) (c-export :c))
  (ffi:call echo_double x))
(defun recursive_float (x n)
  (declare (type f64 x) (type u64 n) (returns f64) (c-export :c))
  (if (= n 0) x (recursive_float x (wrap- n 1))))
(defun ordered_float ()
  (declare (returns f64) (c-export :c))
  (ffi:call ordered_pair (ffi:call next_single 1) (ffi:call next_single 2)))

(defun choose_single (a b flag)
  (declare (type f32 a b) (type u64 flag) (returns f32) (c-export :c))
  (if (= flag 0) b a))
