(defcstruct fa_single (number f32))
(defcstruct fa_double (number f64))
(defcstruct fa_pair (first f32) (second f32))
(defcstruct fa_nested (pair fa_pair) (third f32))
(defcstruct fa_two (first f64) (second f64))
(defcstruct fa_mixed (tag u64) (number f64))
(defcstruct fa_narrow (tag s8) (number f32))
(defcstruct fa_four (a f32) (b f32) (c f32) (d f32))
(defcstruct fa_varied (pair fa_pair) (number f64))
(ffi:import-function "fa_clobber_c" () -> u64 :no-allocation)

(defun fa_single_copy (x)
 (declare (type fa_single x) (returns fa_single) (c-export :c)) x)
(defun fa_double_copy (x)
 (declare (type fa_double x) (returns fa_double) (c-export :c)) x)
(defun fa_pair_copy (x)
 (declare (type fa_pair x) (returns fa_pair) (c-export :c)) (let ((y x)) y))
(defun fa_nested_copy (x)
 (declare (type fa_nested x) (returns fa_nested) (c-export :c)) x)
(defun fa_two_copy (x)
 (declare (type fa_two x) (returns fa_two) (c-export :c)) x)
(defun fa_narrow_copy (x)
 (declare (type fa_narrow x) (returns fa_narrow) (c-export :c)) x)
(defun fa_varied_copy (x)
 (declare (type fa_varied x) (returns fa_varied) (c-export :c)) x)
(defun fa_join (flag x y)
 (declare (type c-int flag) (type fa_two x y) (returns fa_two) (c-export :c))
 (if (= flag 0) (fa_two_copy x) (fa_two_copy y)))

(ffi:import-function "fa_partial_c"
 ((a f64) (b f64) (c f64) (d f64) (e f64) (f f64) (g f64)
  (x fa_two) (tail f64) (mark u64)) -> fa_two)
(defun fa_partial (a b c d e f g x tail mark)
 (declare (type f64 a b c d e f g tail) (type fa_two x) (type u64 mark)
          (returns fa_two) (c-export :c))
 (ffi:call fa_partial_c a b c d e f g x tail mark))

(ffi:import-function "fa_gp_full_c"
 ((a u64) (b u64) (c u64) (d u64) (e u64) (f u64)
  (x fa_mixed) (tail f64) (mark u64)) -> fa_mixed)
(defun fa_gp_full (a b c d e f x tail mark)
 (declare (type u64 a b c d e f mark) (type fa_mixed x) (type f64 tail)
          (returns fa_mixed) (c-export :c))
 (ffi:call fa_gp_full_c a b c d e f x tail mark))

(ffi:import-function "fa_fp_full_c"
 ((a f64) (b f64) (c f64) (d f64) (e f64) (f f64) (g f64) (h f64)
  (x fa_mixed) (mark u64)) -> fa_mixed)
(defun fa_fp_full (a b c d e f g h x mark)
 (declare (type f64 a b c d e f g h) (type fa_mixed x) (type u64 mark)
          (returns fa_mixed) (c-export :c))
 (ffi:call fa_fp_full_c a b c d e f g h x mark))

(ffi:import-function "fa_hfa_partial_c"
 ((a f64) (b f64) (c f64) (d f64) (e f64) (f f64)
  (x fa_four) (tail f32) (mark u64)) -> fa_four)
(defun fa_hfa_partial (a b c d e f x tail mark)
 (declare (type f64 a b c d e f) (type fa_four x) (type f32 tail) (type u64 mark)
          (returns fa_four) (c-export :c))
 (ffi:call fa_clobber_c)
 (ffi:call fa_hfa_partial_c a b c d e f x tail mark))

(ffi:import-function "fa_root_check_c"
 ((x fa_nested) (scale f64) (y fa_narrow) (live value)) -> fa_nested)
(defun fa_roots (x scale y live)
 (declare (type fa_nested x) (type f64 scale) (type fa_narrow y) (type value live)
          (returns fa_nested) (c-export :c))
 (ffi:call fa_clobber_c)
 (ffi:call fa_root_check_c x scale y live))

(ffi:import-function "fa_raw_check_c" ((x fa_double)) -> fa_double)
(defun fa_raw (x)
 (declare (type fa_double x) (returns fa_double) (c-export :c))
 (ffi:call fa_raw_check_c x))
